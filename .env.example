# ───────────────────────────────────────────────────────────────────────────
#  Trinetra Capital AI — environment configuration
#  Copy to `.env` and fill in. Never commit your real .env.
# ───────────────────────────────────────────────────────────────────────────

# ── LLM (agents) — REQUIRED ──────────────────────────────────────────────────
# NVIDIA NIM powers the agents.
NVIDIA_API_KEY=your_nvidia_api_key_here
# Optional: override the agent model
# TRINETRA_AGENT_MODEL=meta/llama-3.3-70b-instruct

# Groq powers the SUPERVISOR (fast routing → much lower latency). Recommended.
GROQ_API_KEY=your_groq_api_key_here
# TRINETRA_SUPERVISOR_MODEL=meta/llama-3.3-70b-instruct
# TRINETRA_GROQ_SUPERVISOR=true     # set false to route with the NVIDIA model instead

# ── Groww broker — connect your account ──────────────────────────────────────
# Get these from https://groww.in/trade-api/docs  (see `python connect_groww.py`).
# Choose ONE flow:
#
#   A) TOTP flow (recommended — token auto-rotates daily):
GROWW_API_KEY=your_totp_token_or_api_key
GROWW_TOTP_SECRET=your_totp_secret
#
#   B) Approval flow (API key + secret):
# GROWW_API_KEY=your_api_key
# GROWW_API_SECRET=your_api_secret

# ── Trading safety ───────────────────────────────────────────────────────────
# paper = simulated fills (default, safe).  live = REAL orders on Groww.
GROWW_TRADING_MODE=paper
# Hard per-order rupee ceiling enforced before any order (paper or live).
GROWW_MAX_ORDER_VALUE=100000
# Default product: CNC (delivery) or MIS (intraday).
GROWW_DEFAULT_PRODUCT=CNC
# Default exchange: NSE or BSE.
GROWW_DEFAULT_EXCHANGE=NSE
# Virtual starting cash for paper mode.
TRINETRA_PAPER_CASH=1000000

# ── Observability (optional) ─────────────────────────────────────────────────
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=trinetra-capital-ai

# ── Logging ──────────────────────────────────────────────────────────────────
# TRINETRA_LOG_LEVEL=INFO
